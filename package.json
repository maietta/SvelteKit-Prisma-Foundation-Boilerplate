		"@types/cookie": "^0.5.4",
		"@types/jquery": "^3.5.32",
		"@types/jsonwebtoken": "^9.0.9",
		"@types/node": "^18.19.86",
		"autoprefixer": "^10.4.21",
		"eslint": "^8.57.1",
